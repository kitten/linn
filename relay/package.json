{
  "name": "linn-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --test test/*.test.ts",
    "test:interop": "node scripts/interop.ts",
    "test:heartbeats": "node scripts/heartbeats.ts",
    "test:control": "node scripts/control.ts",
    "test:offline": "node scripts/offline.ts",
    "dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "@types/node": "26.6.6",
    "miniflare": "5.20261113.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  }
}
